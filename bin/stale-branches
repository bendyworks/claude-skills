#!/usr/bin/env ruby
# frozen_string_literal: true

# stale-branches -- report, and optionally delete, local branches whose
# work has already reached the default branch.
#
# By default it prints one row per local branch with a DELETE or keep
# verdict and the evidence behind it, and changes nothing: no branch,
# ref, working tree, or index is touched. (The content check does write
# a tree object into the repository's object store, which is
# unreferenced and reclaimed by the next gc -- "touches nothing" would
# be a nice claim and is not a true one.) With --delete it removes
# exactly the branches that same report marks DELETE. The judgment of
# whether a keeper deserves a closer look is the caller's; this tool's
# job is to make the evidence explicit and to refuse to guess.
#
# Stdlib-only (no gems). Run with --help for usage.
#
# The logic here is mostly the shelling-out, so the traps are mostly
# shell-level, and each one below has already shipped as a defect in
# the prose procedure this tool replaces:
#
#   -C is passed through to git as `git -C DIR`, never applied with
#   Dir.chdir. A chdir survives past the failure that interrupted it,
#   and what it aims subsequent commands at is the caller's own clone.
#
#   The default branch is asked of the remote with `ls-remote --symref`.
#   refs/remotes/<remote>/HEAD is read in exactly one place -- the
#   offline fallback, where an older answer from the remote beats a
#   hardcoded guess -- and never when the remote can be asked. That ref
#   is a local
#   cache written when the repository was cloned and not updated since,
#   so where the default branch has changed it names the old one -- and
#   names a branch that really exists and really is pushed, so nothing
#   about reading it fails or looks wrong. Every verdict downstream is
#   then measured against the wrong branch. `remote set-head --auto`
#   repairs that ref, but only for whoever remembers to run it; asking
#   the remote needs no memory and writes nothing.

require 'json'
require 'open3'
require 'optparse'

module StaleBranches
  Error = Class.new(StandardError)

  DEFAULT_REMOTE = 'origin'

  USAGE = <<~TXT
    Usage: stale-branches [-C DIR] [--remote NAME] [--repo OWNER/NAME]
                          [--offline] [--delete]

    Reports every local branch with a verdict and the evidence behind
    it. Nothing is deleted unless --delete is given, and then only the
    branches the same report marks DELETE.

      -C DIR          the repository to sweep (default: the working directory)
      --remote NAME   the remote whose default branch verdicts are measured
                      against (default: #{DEFAULT_REMOTE})
      --repo OWNER/NAME
                      the GitHub project whose pull requests are read
                      (default: whichever one gh resolves from DIR). Name it
                      when DIR is a clone of a fork -- your pull requests live
                      in the project you opened them against, and asking the
                      fork comes back empty rather than failing
      --offline       do not consult pull requests at all
      --delete        delete the branches marked DELETE
      -h, --help      print this message

    A branch is kept unless the evidence positively says its work has
    landed. Unpushed work and an unanswerable question both end in a
    keep, and verdicts are always measured against what the remote had
    as of your last fetch -- never against a local branch, which may
    carry commits no remote has seen.
  TXT

  # Repeated into the report on stdout because the warnings go to
  # stderr, and a redirected report would otherwise read as though every
  # verdict in it had been checked against a pull request.
  UNCONSULTED_NOTICE = 'NOTE: pull requests were not consulted for this report; ' \
                       'see the warnings on stderr.'

  # Which remote-tracking ref the sweep falls back to when the remote
  # cannot be reached, in order. Picking one is a guess about which
  # branch is the default, which is why taking one is always
  # announced -- but it is still a record of what the remote had,
  # never a local branch.
  FALLBACK_BRANCHES = %w[main master].freeze

  # Names a team keeps regardless of what any evidence says. Most are
  # ancestors of the default branch most of the time, so without this
  # list the cheap first pass alone would clear them.
  LONG_LIVED_NAMES = %w[main master develop staging production gh-pages].freeze

  # A prefix rather than a name: a team cuts release/1.x, release/2.0
  # and so on, and each is long-lived for as long as it is supported.
  # The trailing slash is what keeps `releases-ui` out.
  LONG_LIVED_PREFIXES = ['release/'].freeze

  # The suffix a hand-made safety net carries. Someone typed it to keep
  # something; the sweep is not the tool that second-guesses that.
  BACKUP_SUFFIX = '-backup'

  # Where `merge-tree --write-tree` arrived. Before it, merge-tree was
  # a different tool taking three arguments, so the command below does
  # not fail in some recognizable way -- it fails the way a conflict
  # does, and a sweep that did not check the version would report a
  # repository in which every branch conflicts.
  MINIMUM_GIT = [2, 38].freeze

  # Git environment variables that name a repository, unset for every
  # child. `git -C DIR` does NOT override an inherited GIT_DIR, so
  # without this a sweep run with one set reports on, and with --delete
  # destroys branches in, a repository the caller never named -- the
  # exact failure -C was chosen to prevent, arriving through the
  # environment rather than through Dir.chdir. This is not exotic:
  # git hooks, `git rebase --exec`, `git bisect run`, and filter-branch
  # all set GIT_DIR for what they run.
  #
  # GIT_CEILING_DIRECTORIES is deliberately left alone. It only stops
  # repository discovery early, so honoring it can lead this tool to
  # refuse a directory and never to act on an unintended one, which is
  # the safe direction for something that deletes.
  REDIRECTING_ENV_KEYS = %w[
    GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
    GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_NAMESPACE
  ].freeze

  # A nil value unsets the variable for the child. The prompt settings
  # are here because git asks for credentials on /dev/tty rather than
  # on stdin, so capturing the child's pipes does not stop `ls-remote`
  # from blocking a report that was supposed to be unattended.
  CHILD_ENV = REDIRECTING_ENV_KEYS.to_h { |key| [key, nil] }
                                  .merge('GIT_TERMINAL_PROMPT' => '0',
                                         'GIT_ASKPASS' => nil,
                                         'SSH_ASKPASS' => nil,
                                         # git translates its fatal
                                         # messages, and one of them is
                                         # matched below to tell a
                                         # question it could not attempt
                                         # from one this tool broke.
                                         'LC_ALL' => 'C')
                                  .freeze

  # The variables that redirect gh the way GIT_DIR redirects git, unset
  # for the forge's children. GH_REPO wins over the repository gh would
  # resolve from its working directory, so an ambient one answers every
  # query about a different project -- and answers it with [] and exit
  # 0, which is not a failure this tool can notice: no warning prints,
  # open-pull-request protection silently stops protecting, and every
  # branch reads as having no pull request. That is the same hazard
  # REDIRECTING_ENV_KEYS documents, arriving through a variable git
  # never looks at.
  #
  # The colour forcing is here for a different reason with the same
  # ending. gh honours CLICOLOR_FORCE and GH_FORCE_TTY even when its
  # output is a pipe, and NO_COLOR does not override them; the reply
  # then carries ANSI escapes, JSON.parse raises, and the whole forge
  # half is off for anyone who sets either in a shell profile.
  #
  # GH_HOST is deliberately left alone: it is how a GitHub Enterprise
  # user names their host, and honouring it can only send the question
  # somewhere the caller already chose.
  FORGE_REDIRECTING_ENV_KEYS = %w[GH_REPO CLICOLOR_FORCE GH_FORCE_TTY].freeze

  FORGE_ENV = CHILD_ENV.merge(FORGE_REDIRECTING_ENV_KEYS.to_h { |key| [key, nil] })
                       .merge('NO_COLOR' => '1')
                       .freeze

  # One branch's verdict and the rule that reached it. The verdict is
  # asked through the predicate rather than compared as a string, so
  # the spelling lives in one place -- and the report's own shouted
  # DELETE against a quiet keep is a rendering choice made there.
  Row = Struct.new(:branch, :verdict, :reason) do
    def delete?
      verdict == 'DELETE'
    end
  end

  # A bare object name, and the message git uses for two histories with
  # no commit in common. Both are how merge-tree distinguishes a
  # question it answered from one it could not attempt.
  OBJECT_NAME = /\A[0-9a-f]{40,64}\z/
  UNMERGEABLE = /unrelated histories/

  # What became of one branch the report marked. `deleted` is decided
  # by looking at the repository afterwards rather than at what git
  # said, and `detail` carries git's own explanation of a refusal,
  # which is the actionable half of one. `sha` is read before the
  # deletion, because `git branch -D` removes the branch's reflog along
  # with the branch and that object name is then the only breadcrumb
  # back to the work.
  Deletion = Struct.new(:branch, :sha, :deleted, :detail) do
    def deleted?
      deleted
    end
  end

  # The branch every verdict is measured against, and where the answer
  # came from -- which the report has to say, because a guess that
  # announces itself can be re-run against the real answer and a silent
  # one cannot. The tip is carried alongside because the remote hands
  # it over in the same breath.
  DefaultBranch = Struct.new(:name, :sha, :source, :detail) do
    def from_remote?
      source == :remote
    end
  end

  # The parsed command line. Held as a value rather than a hash so a
  # stage reaching for a flag that does not exist fails where it is
  # written rather than reading as nil.
  Options = Struct.new(:dir, :remote, :repo, :offline, :delete, :help) do
    def offline?
      offline
    end

    def delete?
      delete
    end

    def help?
      help
    end
  end

  # An option value must not begin with a dash: a mandatory-argument
  # option otherwise swallows a following flag as its value, so
  # `-C --delete` parses as a directory named --delete with no delete
  # flag set, and the sweep acts on the command it misread. Anchored
  # end to end to state explicitly the whole-argument match optparse
  # requires of an acceptance pattern.
  VALUE_NOT_FLAG = /\A[^-].*\z/m

  # What gh accepts for --repo: OWNER/NAME, optionally preceded by a
  # host. Narrowed here for the same reason -C and --remote are, and
  # with one extra: the host component decides which server the question
  # -- and the credentials for it -- are sent to, so a typo there is
  # worth refusing rather than forwarding.
  REPO_NAME = %r{\A[\w.-]+/[\w.-]+(?:/[\w.-]+)?\z}

  module_function

  # Parsed here rather than in the CLI class below because nothing about
  # it reaches outside the process: this is the last point at which what
  # the caller typed can still be refused for free.
  def parse_options(argv)
    values = {}
    flags = { offline: false, delete: false, help: false }
    rest = permute(argv, values, flags)
    # No default for :repo. Every other value here has an obvious one,
    # and this does not: a guess would name a GitHub project nobody
    # asked about, and gh answering for the wrong one is an empty
    # result rather than an error. Left nil, the question of which
    # project to ask is gh's to answer from the repository itself.
    options = Options.new(values.fetch(:dir, '.'), values.fetch(:remote, DEFAULT_REMOTE),
                          values[:repo], flags[:offline], flags[:delete], flags[:help])
    # A request for usage is answered rather than corrected. Someone
    # typing `stale-branches --help main` is asking what the command
    # takes, and telling them their argument is unexpected is a worse
    # answer than the one they asked for.
    return options if options.help?

    raise Error, "unexpected extra arguments: #{rest.map(&:inspect).join(', ')}" unless rest.empty?

    options
  end

  def permute(argv, values, flags)
    parser = OptionParser.new do |o|
      o.banner = USAGE
      # Abbreviation is off. OptionParser accepts any unambiguous
      # prefix by default, which makes `--del` -- and `--d` -- mean
      # --delete, so a typo one character into a flag deletes branches.
      # Every other guard here exists to refuse a misread command line;
      # this is the hole they were all standing around.
      o.require_exact = true
      o.on('-C DIR', VALUE_NOT_FLAG, 'the repository to sweep') do |v|
        set_once(values, :dir, '-C', v)
      end
      o.on('--remote NAME', VALUE_NOT_FLAG,
           'the remote whose default branch is measured against') do |v|
        set_once(values, :remote, '--remote', v)
      end
      o.on('--repo OWNER/NAME', REPO_NAME,
           'the GitHub project whose pull requests are read') do |v|
        set_once(values, :repo, '--repo', v)
      end
      # Repeated booleans are accepted where a repeated value option is
      # refused: repeating one discards no input and leaves the sweep
      # acting on exactly what was typed.
      o.on('--offline', 'do not consult pull requests at all') { flags[:offline] = true }
      o.on('--delete', 'delete the branches marked DELETE') { flags[:delete] = true }
      o.on('-h', '--help', 'print usage') { flags[:help] = true }
      # OptionParser answers --version itself unless told otherwise,
      # and there is no version to give: the plugin this ships in is
      # deliberately versionless. Refusing it as the unknown flag it is
      # beats answering "version unknown".
      o.on('--version') { raise Error, 'invalid option: --version' }
    end
    # permute, not parse: #parse permutes positionals past flags only
    # while POSIXLY_CORRECT is unset, so the same argv would mean two
    # things on two machines.
    parser.permute(argv)
  rescue OptionParser::ParseError => e
    raise Error, e.message
  end

  # Last-wins on a repeated option silently discards the first value,
  # which for -C means sweeping a repository the caller also named and
  # did not get.
  def set_once(values, key, flag, value)
    raise Error, "duplicate #{flag}" if values.key?(key)

    values[key] = value
  end

  # `ls-remote --symref <remote> HEAD` answers in two lines: the symref
  # naming the branch, then that branch's tip.
  #
  #   ref: refs/heads/develop<TAB>HEAD
  #   55a8fc0a4f21946df49bb9900352cd09e2ef2fc2<TAB>HEAD
  #
  # A remote with no commits yet prints neither and exits 0, so an
  # empty answer is a real answer and not a failure -- the caller tells
  # the two apart by the exit status, not by this returning nil. The
  # tip is optional on its own account: only the name is needed to say
  # which branch is the default.
  def parse_remote_head(output)
    name = output[%r{^ref: refs/heads/(\S+)\tHEAD$}, 1]
    return nil unless name

    DefaultBranch.new(name, output[/^([0-9a-f]{4,64})\tHEAD$/, 1], :remote)
  end

  # Why this branch is not a candidate, or nil if it is one. The order
  # is the specification and not an implementation detail: a branch can
  # satisfy several of these at once -- the default branch is usually on
  # the long-lived list, and the branch HEAD is on is listed as a
  # worktree of its own -- so the first rule that fires is what the
  # report has to say, or a sweep that never learned which branch is the
  # default reports "long-lived" and looks right.
  #
  # `current` is nil where HEAD is detached, and it must stay nil rather
  # than becoming a string: `rev-parse --abbrev-ref HEAD` answers "HEAD"
  # there, where `symbolic-ref --quiet HEAD` reports nothing at all.
  def protection_for(branch, default:, current:, worktrees:)
    return 'protected:default' if branch == default
    return 'protected:current' if current && branch == current
    return 'protected:worktree' if worktrees.include?(branch)
    return 'protected:long-lived' if long_lived?(branch)
    return 'protected:backup' if branch.end_with?(BACKUP_SUFFIX)

    nil
  end

  def long_lived?(branch)
    LONG_LIVED_NAMES.include?(branch) ||
      LONG_LIVED_PREFIXES.any? { |prefix| branch.start_with?(prefix) }
  end

  # The report, rendered from rows rather than printed as each is
  # decided, so its order is the reader's rather than the sweep's.
  # Sorted by name because a report is read twice: once now, and once
  # against the last run, where a stable order is what makes the
  # difference between them legible.
  #
  # DELETE is the only verdict in capitals, and a reader skimming a
  # long report is looking for exactly what this tool proposes to
  # destroy. Columns are padded to the widest value rather than to a
  # fixed width, which keeps a long branch name from pushing the
  # verdict out of alignment for every other row.
  def render_report(rows)
    ordered = rows.sort_by(&:branch)
    branch_width = [*ordered.map { |row| row.branch.length }, 'branch'.length].max
    verdict_width = ['verdict', 'DELETE', 'keep'].map(&:length).max

    lines = [format_row('branch', 'verdict', 'reason', branch_width, verdict_width)]
    ordered.each do |row|
      verdict = row.delete? ? 'DELETE' : 'keep'
      lines << format_row(row.branch, verdict, row.reason, branch_width, verdict_width)
    end
    deletions = ordered.count(&:delete?)
    lines << ''
    counted = ordered.length == 1 ? '1 branch' : "#{ordered.length} branches"
    lines << "#{counted}, #{deletions} marked DELETE"
    "#{lines.join("\n")}\n"
  end

  # Two spaces between columns at their widest, which is what the
  # report's own grader keys on: one space would let a padded column
  # run into the next.
  def format_row(branch, verdict, reason, branch_width, verdict_width)
    "#{branch.ljust(branch_width)}  #{verdict.ljust(verdict_width)}  #{reason}"
  end

  # Whether anybody still has a pull request open on this branch. Asked
  # of the protected set rather than of proof (b), and so asked of every
  # branch rather than only of the ones the content check could not
  # answer for: the branch this protects is the one whose work has
  # already landed by another route, and proof (b) never runs on those.
  def open_pull_request?(records)
    records.any? { |record| state?(record, 'OPEN') }
  end

  # trust_forks is what --repo buys. On a clone of a fork every one of
  # your own pull requests goes from your fork to the project you named,
  # so GitHub reports all of them as cross-repository -- and rejecting
  # those would leave proof (b) unable to clear anything at all there,
  # reporting "the merged pull request came from a fork" about the
  # caller's own work. Naming the project explicitly is the caller
  # saying where their pull requests live, so the clause stands down.
  #
  # What still does the work is headRefOid == tip, one clause below. A
  # merged pull request into the default branch carrying this branch's
  # exact tip means the content landed, whoever opened it: merging takes
  # write access, and a stranger who pushed your commits to their fork
  # and got them merged has landed your work rather than stolen it.
  # Without --repo the question went to your own repository, where a
  # cross-repository record really is somebody else's fork answering a
  # question about a branch that merely shares a name -- so there the
  # clause stays.
  #
  # The clause logic of proof (b): what a branch's pull requests, taken
  # together, say about whether its work reached the default branch.
  # Every pull request reaching here is finished, because an open one
  # would have been protected before the content check ran.
  # Pure, because every mistake available here is a comparison -- a
  # state read case-sensitively, a base compared to the wrong name, the
  # newest record read instead of the matching one -- and a comparison
  # is cheapest to pin without a repository in the way.
  #
  # Each clause rejects RECORDS rather than the branch, which is what
  # keeps a fork's merged pull request from taking your own out of
  # consideration. The branch is only kept once nothing is left.
  def pull_request_verdict(records, tip:, default:, trust_forks: false)
    return ['KEEP', 'proof-b:no-pr'] if records.empty?

    merged = records.select { |record| state?(record, 'MERGED') }
    return ['KEEP', 'proof-b:pr-closed'] if merged.empty?

    same_repo = trust_forks ? merged : merged.select { |record| record['isCrossRepository'] == false }
    return ['KEEP', 'proof-b:pr-from-fork'] if same_repo.empty?

    on_default = same_repo.select { |record| record['baseRefName'] == default }
    return ['KEEP', 'proof-b:pr-other-base'] if on_default.empty?

    landed_here = on_default.any? { |record| record['headRefOid'] == tip }
    landed_here ? ['DELETE', 'proof-b:pr-merged'] : ['KEEP', 'proof-b:pr-tip-differs']
  end

  # Compared without regard to case. gh spells these in capitals today,
  # and the failure a case-sensitive test would produce is silent: every
  # state goes unrecognized, which reads as closed and keeps every
  # branch -- a sweep that has stopped working and still looks careful.
  def state?(record, state)
    record['state'].to_s.casecmp?(state)
  end

  # The major and minor of what `git --version` prints, or nil where
  # that is not a version at all.
  def parse_git_version(output)
    found = output[/\d+\.\d+/]
    found&.split('.')&.map(&:to_i)
  end

  # An unreadable version is not new enough. The check would otherwise
  # run and quietly answer wrongly for every branch, which is worse
  # than saying so.
  def content_check_available?(version)
    !version.nil? && (version <=> MINIMUM_GIT) >= 0
  end

  # The only code here that shells out, and the only code that knows
  # the repository is somewhere other than where this process is
  # standing.
  class Git
    # The directory every child of this object runs in. Readable because
    # the forge runs its own children in the same one, and the two
    # disagreeing about which repository is being swept is not a state
    # worth being able to reach.
    attr_reader :dir, :remote

    def initialize(dir:, remote:)
      @dir = dir
      @remote = remote
    end

    # ENOENT is git missing; EACCES is a git that exists and cannot be
    # run. Both are one sentence to the caller, and neither should
    # arrive as a Ruby backtrace past this CLI's single rescue.
    def capture(*args)
      Open3.capture3(CHILD_ENV, 'git', '-C', @dir, *args)
    rescue Errno::ENOENT, Errno::EACCES => e
      raise Error, "could not run git: #{e.message}"
    end

    # For the several facts git answers by succeeding or failing rather
    # than by printing.
    def succeeds?(*args)
      capture(*args).last.success?
    end

    def lines(*args)
      stdout, stderr, status = capture(*args)
      raise Error, "git #{args.first} failed: #{stderr.strip}" unless status.success?

      stdout.lines(chomp: true)
    end

    def remotes
      lines('remote')
    end

    # --verify with a full refname, so a tag of the same name cannot
    # answer for a branch that does not exist.
    def ref?(name)
      succeeds?('show-ref', '--verify', '--quiet', name)
    end

    def sha(ref)
      lines('rev-parse', ref).first
    end

    # Answered by walking the commit graph rather than by comparing
    # content, so a yes here is exact: the second ref contains the first
    # commit for commit.
    #
    # Exit 1 is the documented "no"; anything else is git failing to
    # answer, and reading that as a no is how a broken run turns into a
    # confident verdict.
    # success? rather than a comparison on exitstatus, which is nil for
    # a child killed by a signal -- and a NoMethodError there escapes
    # the one rescue this CLI has, surfacing as a Ruby backtrace.
    def ancestor?(ref, other)
      _stdout, stderr, status = capture('merge-base', '--is-ancestor', ref, other)
      return true if status.success?
      return false if status.exitstatus == 1

      raise Error, "git merge-base --is-ancestor failed: #{stderr.strip}"
    end

    def object?(name)
      succeeds?('cat-file', '-e', "#{name}^{commit}")
    end

    # defined? rather than ||=, so an unreadable version is remembered
    # as unreadable instead of re-shelling git on the one path where
    # asking it has already failed.
    def version
      return @version if defined?(@version)

      # Asked WITHOUT -C. `git -C <nonexistent> --version` exits 128
      # with nothing on stdout, so a mistyped directory would read as a
      # git too old for the content check and send the caller off to
      # upgrade git over a typo.
      stdout, = Open3.capture3(CHILD_ENV, 'git', '--version')
      @version = StaleBranches.parse_git_version(stdout.to_s)
    rescue Errno::ENOENT, Errno::EACCES => e
      raise Error, "could not run git: #{e.message}"
    end

    # Merges into a tree git writes and never checks out, so the
    # caller's working tree, index, and refs are untouched and there is
    # no merge to abort afterwards. Returns the merged tree's object
    # name, and whether a merged tree was produced at all.
    #
    # Not every non-zero exit is an answer. A content conflict exits 1
    # with the merged tree still on stdout; histories with nothing in
    # common exit 128 saying so; a ref git cannot resolve exits with
    # nothing on stdout and a message on stderr. The first two are the
    # question coming back unanswerable, which is a verdict. The third
    # is this tool being broken, and reporting it as a conflict would
    # put a reason in the report that names something nobody observed.
    def merge_tree(base, ref)
      stdout, stderr, status = capture('merge-tree', '--write-tree', base, ref)
      tree = stdout.lines.first.to_s.strip
      return [tree, true] if status.success?
      return [nil, false] if tree.match?(OBJECT_NAME) || stderr.match?(UNMERGEABLE)

      raise Error, "git merge-tree failed on #{ref}: #{stderr.lines.first.to_s.strip}"
    end

    # Deletes one branch, and then looks to see whether it is gone.
    #
    # Two things make that last part necessary rather than pedantic.
    # `git branch -d` takes only the short, ambiguous name and rejects
    # the full refname enumeration hands out; and a name shaped like a
    # flag needs the `--` below, without which `git branch -d -D` exits
    # saying a branch name is required. Both of those are failures a
    # caller reading the exit status alone reports as a clean sweep.
    #
    # -d is asked first, and its refusal is deliberately NOT a veto --
    # worth stating plainly, because treating it as one reads like the
    # safer design. git declines any branch whose commits are not
    # reachable from HEAD or its upstream, which a squash-merged branch
    # never is however plainly its content has landed; honoring the
    # refusal would therefore keep most of what this sweep exists to
    # clear. -D forces what the evidence settled, and the cost of that
    # choice is issue #92.
    def delete_branch(name)
      ref = "refs/heads/#{name}"
      was = sha(ref)
      _stdout, stderr, _status = capture('branch', '-d', '--', name)
      remaining = ref?(ref)
      if remaining
        _stdout, stderr, _status = capture('branch', '-D', '--', name)
        remaining = ref?(ref)
      end

      Deletion.new(name, was, !remaining, stderr.strip)
    end

    # `<ref>^{tree}` is one argument to git and never touches a shell,
    # so the braces reach git as typed. Written as a shell word instead,
    # it is a glob that some shells expand to nothing and the whole
    # comparison then silently changes meaning.
    def tree_of(ref)
      sha("#{ref}^{tree}")
    end

    # nil rather than a failure where the ref is absent or is not
    # symbolic, both of which are ordinary states rather than problems.
    def symbolic_ref(name)
      stdout, _stderr, status = capture('symbolic-ref', '--quiet', name)
      status.success? ? stdout.strip : nil
    end

    # Full refnames, which is the form that is unambiguous: a tag
    # sharing a branch's name makes every bare-name lookup answer about
    # the tag, and both fixtures build that collision because a real
    # repository does. Callers convert to short names knowingly --
    # `git branch -d` refuses a full refname and takes only the
    # ambiguous short one.
    def local_branches
      lines('for-each-ref', '--format=%(refname)', 'refs/heads/')
        .map { |ref| ref.delete_prefix('refs/heads/') }
    end

    # nil on a detached HEAD, where there is no branch to name.
    def current_branch
      stdout, _stderr, status = capture('symbolic-ref', '--quiet', '--short', 'HEAD')
      status.success? ? stdout.strip : nil
    end

    # Every branch checked out anywhere, this worktree included. git
    # refuses to delete any of them, so a sweep that lists one as a
    # candidate produces a mid-run error instead of a verdict.
    def worktree_branches
      lines('worktree', 'list', '--porcelain')
        .filter_map { |line| line[%r{\Abranch refs/heads/(.+)\z}, 1] }
    end

    # What the verdicts are measured against, once the default branch
    # has a name: the remote-tracking ref, and nothing else.
    #
    # The local branch of the same name is not a fallback. It is
    # whatever this developer has advanced, and measuring against
    # unpushed commits on it clears branches whose work reached nobody
    # -- a branch merged into a local-only main is then deleted, and
    # `git branch -D` takes its reflog with it. That is the one mistake
    # this tool must never make, so a repository with no remote-tracking
    # ref for its default branch gets a refusal instead of a guess.
    # `git clone --single-branch` produces exactly that repository, so
    # the refusal has to say what would fix it.
    def default_ref(name)
      tracking = "refs/remotes/#{remote}/#{name}"
      return tracking if ref?(tracking)

      raise Error, "#{tracking} does not exist, so there is nothing here recording what " \
                   "#{remote} has. Run `git fetch #{remote} #{name}` and try again -- the " \
                   'local branch of that name is not a substitute, since it may carry ' \
                   'commits no remote has ever seen'
    end

    # git's own first line of complaint is carried into the fallback,
    # because an auth failure, a DNS error and a genuinely offline
    # laptop are three different situations that otherwise arrive as
    # one sentence -- and this is the branch that routes the run onto a
    # guess, so it is the last place to be vague about why.
    def default_branch
      assert_remote_configured!
      stdout, stderr, status = capture('ls-remote', '--symref', remote, 'HEAD')
      head = status.success? ? StaleBranches.parse_remote_head(stdout) : nil
      return head if head

      fallback_default_branch(fallback_detail(stderr, status))
    end

    private

    # A remote that was never configured is a misspelling, and the
    # fallback below is not the answer to one: continuing would measure
    # every verdict against a branch nobody named. A remote that exists
    # and cannot be reached is the different case the fallback is for.
    def assert_remote_configured!
      configured = remotes
      return if configured.include?(remote)

      known = configured.empty? ? 'this repository has none' : "configured: #{configured.join(', ')}"
      raise Error, "no such remote: #{remote} (#{known})"
    end

    # Only one line of git's complaint, and only its first: the rest is
    # boilerplate, and a multi-line warning carrying git's own "fatal:"
    # prefixes at the start of a line reads as though this tool broke.
    #
    # A remote that answered without naming a default branch is not a
    # remote that could not be reached, and saying so saves the reader
    # from checking a network that is fine. It says "no default branch"
    # rather than "no refs": a remote holding only tags, and a server
    # not advertising the symref capability, both land here having
    # advertised plenty.
    def fallback_detail(stderr, status)
      return 'it advertised no default branch' if status.success?

      stderr.lines.first.to_s.strip
    end

    # refs/remotes/<remote>/HEAD is consulted HERE and nowhere else, and
    # the difference is the whole point. When the remote can be asked,
    # that ref is the thing to avoid: it is a clone-time cache that goes
    # stale silently, and every verdict measured against it is then
    # measured against a branch the team stopped shipping from. When the
    # remote cannot be asked, it is still the remote's own answer --
    # just an older one -- and an older answer from the remote beats a
    # hardcoded guess at `main`, which on a repository shipping from
    # develop is not an answer at all.
    def fallback_default_branch(detail)
      name = remembered_default ||
             FALLBACK_BRANCHES.find { |candidate| ref?("refs/remotes/#{remote}/#{candidate}") }
      unless name
        raise Error, "could not ask #{remote} for its default branch (#{detail}), and no " \
                     "#{FALLBACK_BRANCHES.map { |b| "#{remote}/#{b}" }.join(' or ')} " \
                     'to fall back to'
      end

      DefaultBranch.new(name, nil, :fallback, detail)
    end

    # The branch this repository last recorded the remote calling
    # default, or nil where it never recorded one.
    def remembered_default
      name = head_ref_target
      name if name && ref?("refs/remotes/#{remote}/#{name}")
    end

    def head_ref_target
      symbolic_ref("refs/remotes/#{remote}/HEAD")
        &.sub(%r{\Arefs/remotes/#{Regexp.escape(remote)}/}, '')
    end
  end

  # The only code that runs the GitHub CLI, and the only place this tool
  # asks anything of a network. gh is run with the swept repository as
  # the child's working directory rather than being told which
  # repository to ask about, so it applies its own resolution rules --
  # `gh repo set-default`, enterprise hosts, insteadOf rewrites -- and
  # refuses a remote that is not GitHub. Deriving owner/name here
  # instead would mean a GitLab remote resolving to a same-named
  # github.com repository, whose pull requests would then be read as
  # evidence about these branches.
  class Forge
    # The fields this reads, and no others. gh refuses a field name it
    # does not know, so this list is checked by the first query rather
    # than by a verdict that quietly went wrong. headRefName is read
    # only to confirm the reply is about the branch that was asked
    # about; the other four are what the verdict turns on.
    FIELDS = %w[state headRefName headRefOid baseRefName isCrossRepository].freeze

    # gh truncates at 30 by default and says nothing when it does. A
    # branch with more pull requests than this is not a shape worth
    # designing for, but silently reading the first 30 of them is, so
    # the limit is stated rather than inherited. Truncation stays
    # silent, and gh returns newest first while the clearing record may
    # be an older one -- so what a truncated reply costs is a deletion,
    # never a wrongful one.
    LIMIT = 100

    attr_reader :failure

    # Whether the caller named the project rather than leaving it to gh.
    # Proof (b) reads this: see pull_request_verdict on what it changes.
    def named_repo?
      !@repo.nil?
    end

    def initialize(dir:, repo: nil, offline: false)
      @dir = dir
      @repo = repo
      @records = {}
      @offline = offline
      @available = !offline
    end

    # Asked for rather than suffered. The verdicts are the same either
    # way, and what differs is whether the caller chose them: a sweep
    # that could not reach gh has to say so and refuse to delete, and
    # one told not to try has already been told.
    def offline?
      @offline
    end

    def available?
      @available
    end

    # The pull requests naming this branch, or nil when the forge could
    # not be reached at all. nil and [] are the distinction the whole
    # degradation rests on: [] is an answer, and nil is the absence of
    # one, and reporting the first where the second is true is claiming
    # a branch has no pull request without having looked.
    #
    # Answered once per branch. Open-pull-request protection and proof
    # (b) both read this, and paying twice for one answer would double
    # the network cost of every sweep.
    def pull_requests(branch)
      return nil unless @available

      @records.fetch(branch) { @records[branch] = ask_about(branch) }
    end

    private

    # ENOENT is gh not installed -- the ordinary state of a machine that
    # has never needed it -- or the swept directory no longer being
    # there; EACCES is a gh that exists and cannot be run. Neither is exceptional enough to end a sweep that
    # still has a content check to run, so both degrade like any other
    # failure to answer.
    def ask_about(branch)
      stdout, stderr, status = Open3.capture3(FORGE_ENV, 'gh', *query_for(branch), chdir: @dir)
      return unavailable(first_line(stderr)) unless status.success?

      records_from(JSON.parse(stdout), branch)
    rescue Errno::ENOENT, Errno::EACCES => e
      unavailable(e.message)
    rescue JSON::ParserError => e
      unavailable("its answer was not the JSON this asked for: #{e.message}")
    end

    # Valid JSON of the wrong shape is not a parse error, and both wrong
    # shapes end somewhere bad: a bare object reads as "no pull request"
    # for every branch, silently, and reaches the verdict logic where
    # indexing an Array with a String raises past this CLI's one rescue.
    # A wrapper or proxy answering with an envelope is all it takes.
    #
    # The reply is also confirmed to be about the branch that was asked
    # about. Everything downstream trusts that gh honoured --head, and
    # nothing here would notice if it had not.
    def records_from(parsed, branch)
      return unavailable('its answer was not a list of pull requests') unless parsed.is_a?(Array)
      return unavailable('its answer held something that is not a pull request') unless
        parsed.all?(Hash)

      parsed.select { |record| record['headRefName'] == branch }
    end

    # gh's failures run to several lines and carry their own advice
    # block, and this ends up inside a parenthetical in a warning
    # somebody reads before authorising deletions. Git#fallback_detail
    # takes the first line for the same reason.
    def first_line(stderr)
      line = stderr.lines.first.to_s.strip
      line.empty? ? 'it said nothing about why' : line
    end

    def query_for(branch)
      args = ['pr', 'list', '--head', branch, '--state', 'all',
              '--limit', LIMIT.to_s, '--json', FIELDS.join(',')]
      @repo ? args + ['--repo', @repo] : args
    end

    # A forge that failed once is treated as unreachable for the rest of
    # the run. Whatever went wrong -- not installed, not authenticated,
    # not a GitHub remote, no network -- is a fact about the repository
    # and not about the branch that happened to be asked first, so
    # asking again would buy one failure per candidate and no answers.
    def unavailable(detail)
      @available = false
      @failure = detail
      nil
    end
  end

  # Gathers the facts and reaches the verdicts. The CLI hands it a way
  # to talk to git and a way to talk to the forge; it hands back rows to
  # print and warnings to say first.
  class Sweep
    attr_reader :default, :measured_ref, :warnings, :branches, :rows, :candidates

    def initialize(git:, forge:)
      @git = git
      @forge = forge
      @warnings = []
      @rows = []
      @candidates = []
    end

    def run
      # Asked before anything else, including before the network call.
      # The answer does not depend on the repository, so a sweep that
      # cannot finish should say so immediately rather than after the
      # slowest thing it does.
      assert_content_check_available!
      @default = @git.default_branch
      @warnings << fallback_warning unless @default.from_remote?
      @measured_ref = @git.default_ref(@default.name)
      note_stale_tracking_ref
      note_stale_head_ref
      partition_branches
      clear_by_ancestry
      protect_open_pull_requests
      decide_by_content
      decide_by_pull_request
      note_unreachable_forge
      self
    end

    # Acts on exactly what the report marked, which is what makes the
    # default run a preview of this one rather than a separate opinion,
    # and in the report's own order so the two read together.
    #
    # Each result is yielded as it happens rather than collected and
    # returned in one go. An interrupt partway through would otherwise
    # leave no record of what had already been destroyed, and since
    # `git branch -D` removes the branch's reflog there is little else
    # to reconstruct it from.
    def delete_marked
      @rows.select(&:delete?).sort_by(&:branch).map do |row|
        result = @git.delete_branch(row.branch)
        yield result if block_given?
        result
      end
    end

    private

    # Refused rather than degraded, because the vocabulary this report
    # speaks has no honest word for it. Every remaining reason states
    # something that was observed -- a conflict seen, content compared
    # -- and reporting one of those for a check that never ran is the
    # same mistake as claiming a pull request was absent without
    # looking. So an old git ends the run, naming what it needs.
    def assert_content_check_available!
      return if StaleBranches.content_check_available?(@git.version)

      raise Error, "this needs git #{MINIMUM_GIT.join('.')} or newer for its content " \
                   "check, found #{@git.version&.join('.') || 'no readable version'}"
    end

    # Said once for the run rather than once per branch, and only when
    # the forge was actually asked and could not answer: available? is
    # true until something fails, so a sweep that never needed to ask
    # says nothing.
    #
    # Which way the verdicts are wrong is the whole message, and they
    # are wrong in both directions at once. The dangerous direction is
    # the deletion: a branch whose work reached the default branch by
    # another route while its own pull request is still open is CLEARED
    # by the content check, and nothing is left to protect it. The mild
    # direction is the keep, where a conflict is reported as an
    # unanswered question rather than as a branch holding unlanded work.
    def note_unreachable_forge
      return if @forge.available?

      @warnings << (@forge.offline? ? offline_warning : unreachable_warning)
    end

    def offline_warning
      'pull requests were not consulted (--offline), so a branch whose work has landed ' \
        'while its own pull request is still open is marked DELETE here'
    end

    def unreachable_warning
      "could not ask gh about pull requests (#{@forge.failure}); every verdict " \
                   'below was reached without them, so a branch whose work has landed while ' \
                   'its own pull request is still open is marked DELETE here, and a branch ' \
                   'whose merge conflicts is kept for want of an answer rather than because ' \
                   'its work is unlanded'
    end

    # Somebody still has a pull request open on this branch, so the
    # sweep does not get an opinion about its content. This is the one
    # protection that costs a network call, and it runs ahead of the
    # content check rather than after it for a reason a keep-count
    # cannot show: a branch whose work has already landed by another
    # route is CLEARED by that check, so a sweep asking about open pull
    # requests afterwards would have deleted it before the question came
    # up. Which pull requests are open is also all this stage reads, so
    # a fork's open pull request protects too -- gh matches --head on
    # branch name alone and nothing in the reply says whose branch it
    # describes, and protection is the direction where being wrong costs
    # a branch kept rather than work destroyed.
    #
    # The ancestry pass runs before this one and settles what it clears,
    # so a branch already merged into the default branch is deleted
    # without the forge being asked even if a pull request on it is
    # open. That is the one exemption, and it is safe for a reason the
    # protection itself does not have: every commit is already on the
    # remote's default branch, so the pull request survives the deletion
    # and so does the work.
    #
    # With no forge reachable, this decides nothing and every branch
    # falls through to the checks that need no network.
    def protect_open_pull_requests
      decide do |branch|
        records = @forge.pull_requests(branch)
        next if records.nil?

        ['KEEP', 'protected:open-pr'] if StaleBranches.open_pull_request?(records)
      end
    end

    # What ancestry cannot answer. A branch squash-merged into the
    # default branch is an ancestor of nothing, yet merging it back
    # produces the default branch's own tree -- so the comparison is of
    # trees, and equality means the content is already there.
    #
    # The three outcomes are three states of knowledge, and the report
    # keeps them apart. A different tree is a positive local fact: this
    # branch definitely adds something. A conflict is neither fact --
    # the check could not run, so nothing available offline can clear
    # the branch, and it is the only outcome a pull-request record
    # could improve on.
    def decide_by_content
      landed = @git.tree_of(@measured_ref)

      decide do |branch|
        ref = "refs/heads/#{branch}"
        tree, merged = @git.merge_tree(@measured_ref, ref)
        # A conflict is the one outcome this stage does not report on.
        # It is left undecided for the forge, which is the only thing
        # that can improve on it -- and when the forge cannot answer
        # either, the stage below reports the conflict as the reason.
        next unless merged
        next ['KEEP', 'kept:not-landed'] unless tree == landed
        next ['KEEP', 'proof-a:tip-only'] unless history_landed?(ref, landed)

        ['DELETE', 'proof-a:content-landed']
      end
    end

    # Proof (a) refuses to clear a branch whose history holds content the
    # default branch never received, because deleting the branch takes
    # its reflog and that content is then reachable from nothing. This
    # stage needs no counterpart, and the difference is the pull request
    # itself: a merged one means the forge holds that head commit at
    # refs/pull/<n>/head permanently, and every commit on the branch is
    # an ancestor of it. Verified against this repository -- the head of
    # pull request 95 still resolves there, long after its branch was
    # deleted. Proof (a) has no such witness: content-landed can be a
    # purely local squash that no forge ever saw.
    #
    # What the forge says about the branches the content check could not
    # answer for. Every one of them is a conflict, so a branch reaching
    # here has no local evidence either way and the pull requests naming
    # it are all there is.
    #
    # With no forge reachable, the conflict itself is the reason -- an
    # unanswered question reported as one. What must never happen is
    # this stage reporting "no pull request" for a branch nothing was
    # ever asked about, which is an absence stated without looking.
    def decide_by_pull_request
      decide do |branch|
        records = @forge.pull_requests(branch)
        next ['KEEP', 'proof-a:conflict'] if records.nil?

        StaleBranches.pull_request_verdict(records, tip: @git.sha("refs/heads/#{branch}"),
                                                    default: @default.name,
                                                    trust_forks: @forge.named_repo?)
      end
    end

    # The tip adding nothing is necessary and not sufficient. A branch
    # that added a file and then removed it has an empty net diff and a
    # history holding content the default branch never received -- and
    # deleting it takes the branch's reflog too, leaving that content
    # reachable from nothing.
    #
    # So every commit the branch does not share with the default branch
    # is asked the same question its tip was asked. A commit that would
    # add something is content that landed nowhere, whatever the tip
    # says. This runs only for branches the tip check already cleared,
    # which is the small minority of candidates.
    def history_landed?(ref, landed)
      @git.lines('rev-list', "#{@measured_ref}..#{ref}").all? do |commit|
        tree, merged = @git.merge_tree(@measured_ref, commit)
        merged && tree == landed
      end
    end

    # The cheap pass, and the only one whose answer is beyond argument.
    # Every branch is named by its full refname, because git resolves a
    # bare name through refs/tags before refs/heads: a tag sharing a
    # branch's name and pointing at the default branch would answer this
    # question about itself, and the branch would be cleared for holding
    # nothing while its own work has never landed.
    def clear_by_ancestry
      decide do |branch|
        ['DELETE', 'pass1:ancestor'] if @git.ancestor?("refs/heads/#{branch}", @measured_ref)
      end
    end

    # Runs a stage over the branches still undecided, moving the ones it
    # answers for into the report and leaving the rest for the stage
    # after it. Later stages are the expensive ones, so what an earlier
    # stage settles is never paid for twice.
    def decide
      remaining = []
      @candidates.each do |branch|
        verdict, reason = yield(branch)
        reason ? @rows << Row.new(branch, verdict, reason) : remaining << branch
      end
      @candidates = remaining
    end

    # Every local branch is either protected -- decided by its name and
    # where HEAD is standing, at no cost -- or a candidate, which is
    # what the evidence-gathering below is spent on.
    def partition_branches
      @branches = @git.local_branches
      current = @git.current_branch
      worktrees = @git.worktree_branches

      @branches.each do |branch|
        reason = StaleBranches.protection_for(branch, default: @default.name,
                                                      current: current, worktrees: worktrees)
        reason ? @rows << Row.new(branch, 'KEEP', reason) : @candidates << branch
      end
    end

    def fallback_warning
      "could not ask #{@git.remote} for its default branch (#{@default.detail}); " \
        "measuring against #{@git.remote}/#{@default.name} as of your last fetch instead"
    end

    # Behind the remote because nobody has fetched. This does not make
    # the verdicts wrong so much as older: an earlier tip clears fewer
    # branches, so the sweep keeps more than it needs to. What the
    # caller cannot tell without being told is that a keep reading
    # "this work never landed" may only mean "this work landed after
    # your last fetch".
    # Which way the two disagree is the whole message, and an equality
    # test cannot tell. Behind is the ordinary state and the mild one:
    # an earlier tip clears fewer branches, so the sweep keeps more than
    # it needs to, and the caller only needs to know that a keep may
    # mean the work landed after their last fetch. Ahead is the
    # hazardous one -- the tracking ref holds commits the remote no
    # longer advertises, so a DELETE can clear work that is on no
    # remote -- and reporting THAT as "behind, run git fetch" reassures
    # the reader in exactly the state that deserves alarm.
    def note_stale_tracking_ref
      return unless @default.sha

      local = @git.sha(@measured_ref)
      return if local == @default.sha

      @warnings << stale_tracking_warning(local)
    end

    def stale_tracking_warning(local)
      case tracking_relation(local)
      when :behind
        "#{@measured_ref} is behind #{@git.remote}; run " \
          "`git fetch #{@git.remote}` -- until then a keep may mean nothing more than " \
          'that the work landed after your last fetch'
      when :ahead
        "#{@measured_ref} holds commits #{@git.remote} does not, so a DELETE below may " \
          'clear work that is on no remote. Check what was force-pushed before acting ' \
          'on this report'
      else
        "#{@measured_ref} and #{@git.remote}'s #{@default.name} have diverged; neither " \
          'contains the other, so treat every verdict below as provisional'
      end
    end

    # Not having the remote's tip is the ORDINARY state, not an exotic
    # one, and it is the first thing to check: somebody pushed and this
    # clone has not fetched since, so the object is not here to compare
    # against. Asking `ancestor?` first would answer "diverged" for
    # every such repository -- the most common state getting the most
    # alarming message, and the fetch advice it actually needs never
    # printed.
    def tracking_relation(local)
      return :behind unless @git.object?(@default.sha)
      return :behind if @git.ancestor?(local, @default.sha)
      return :ahead if @git.ancestor?(@default.sha, local)

      :diverged
    end

    # A stale refs/remotes/<remote>/HEAD is harmless to the verdicts
    # above -- those were measured against what the remote just said --
    # and harmful everywhere else, since every `origin/HEAD` shorthand
    # the caller types resolves through it. Having asked the remote
    # already, saying so costs one comparison.
    def note_stale_head_ref
      # Only where the remote actually answered. In the fallback, the
      # name this would compare against is the sweep's own guess -- so
      # the warning would claim the remote said something it was never
      # asked, and advise `set-head --auto`, which needs the same
      # unreachable remote and would overwrite a correct ref with the
      # guess.
      return unless @default.from_remote?

      target = @git.symbolic_ref("refs/remotes/#{@git.remote}/HEAD")
      return unless target

      named = target.sub(%r{\Arefs/remotes/#{Regexp.escape(@git.remote)}/}, '')
      return if named == @default.name

      @warnings << "refs/remotes/#{@git.remote}/HEAD still names #{named}, but " \
                   "#{@git.remote} says #{@default.name}; run " \
                   "`git remote set-head #{@git.remote} --auto`. This sweep asked the " \
                   'remote, so its own verdicts are unaffected'
    end
  end

  # The half that talks to the outside world: everything above is a pure
  # function of what it was handed.
  class CLI
    def self.run(argv)
      new.run(argv)
    end

    def run(argv)
      options = StaleBranches.parse_options(argv)
      return puts(USAGE) if options.help?

      git = Git.new(dir: options.dir, remote: options.remote)
      forge = Forge.new(dir: git.dir, repo: options.repo, offline: options.offline?)
      sweep = Sweep.new(git: git, forge: forge).run
      # Warnings come before the report rather than after it: a caller
      # reading a piped report from the top must meet the caveats
      # before the rows they apply to.
      sweep.warnings.each { |warning| warn "stale-branches: #{warning}" }
      # And one of them is repeated into the report itself, because the
      # warnings go to stderr and the report to stdout: `stale-branches
      # > report.txt` keeps the rows and drops every caveat, and this is
      # the caveat that changes what the rows mean.
      puts UNCONSULTED_NOTICE unless forge.available?
      print StaleBranches.render_report(sweep.rows)
      return offer_deletion(sweep) unless options.delete?

      refuse_blind_deletion(forge)
      delete_marked(sweep)
    rescue Error => e
      abort "stale-branches: #{e.message}"
    end

    private

    # Deleting on verdicts the forge never saw is the one combination
    # this refuses. The warning above says a branch whose work landed
    # while its pull request is still open is marked DELETE, and going
    # ahead anyway would leave that sentence doing no work. --offline
    # is how a caller says they mean it.
    def refuse_blind_deletion(forge)
      return if forge.available? || forge.offline?

      raise Error, 'not deleting: pull requests could not be read, so nothing above is ' \
                   'protected by an open one. Re-run with --offline to delete on the ' \
                   'local evidence alone.'
    end

    # The object name goes out with each line because it is the only
    # way back to a branch this just removed the reflog of.
    def delete_marked(sweep)
      results = sweep.delete_marked do |result|
        puts "deleted #{result.branch} (was #{result.sha})" if result.deleted?
      end
      failed = results.reject(&:deleted?)
      return if failed.empty?

      failed.each do |result|
        detail = result.detail.empty? ? 'it is still there' : result.detail
        warn "stale-branches: could not delete #{result.branch}: #{detail}"
      end
      # A caller that scripted this has to be able to tell a sweep that
      # did what it was told from one that did not.
      exit 1
    end

    def offer_deletion(sweep)
      marked = sweep.rows.count(&:delete?)
      return if marked.zero?

      puts "Nothing was deleted. Re-run with --delete to remove the #{marked} marked DELETE."
    end
  end
end

StaleBranches::CLI.run(ARGV) if $PROGRAM_NAME == __FILE__
