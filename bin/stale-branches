#!/usr/bin/env ruby
# frozen_string_literal: true

# stale-branches -- report, and optionally delete, local branches whose
# work has already reached the default branch.
#
# By default it prints one row per local branch with a DELETE or keep
# verdict and the evidence behind it, and touches nothing. With
# --delete it removes exactly the branches that same report marks
# DELETE. The judgment of whether a keeper deserves a closer look is
# the caller's; this tool's job is to make the evidence explicit and to
# refuse to guess.
#
# Stdlib-only (no gems). Run with --help for usage.
#
# The logic here is mostly the shelling-out, so the traps are mostly
# shell-level, and each one below has already shipped as a defect in
# the prose procedure this tool replaces:
#
#   -C is passed through to git as `git -C DIR`, never applied with
#   Dir.chdir. A chdir survives past the failure that interrupted it,
#   and what it aims subsequent commands at is the caller's own clone.
#
#   The default branch is asked of the remote with `ls-remote --symref`,
#   never read from refs/remotes/<remote>/HEAD. That ref is a local
#   cache written when the repository was cloned and not updated since,
#   so where the default branch has changed it names the old one -- and
#   names a branch that really exists and really is pushed, so nothing
#   about reading it fails or looks wrong. Every verdict downstream is
#   then measured against the wrong branch. `remote set-head --auto`
#   repairs that ref, but only for whoever remembers to run it; asking
#   the remote needs no memory and writes nothing.

require 'open3'
require 'optparse'

module StaleBranches
  Error = Class.new(StandardError)

  DEFAULT_REMOTE = 'origin'

  USAGE = <<~TXT
    Usage: stale-branches [-C DIR] [--remote NAME] [--delete]

    Reports every local branch with a verdict and the evidence behind
    it. Nothing is deleted unless --delete is given, and then only the
    branches the same report marks DELETE.

      -C DIR          the repository to sweep (default: the working directory)
      --remote NAME   the remote whose default branch verdicts are measured
                      against (default: #{DEFAULT_REMOTE})
      --delete        delete the branches marked DELETE
      -h, --help      print this message

    A branch is kept unless the evidence positively says its work has
    landed. Unpushed work, an unanswerable question, and a missing
    remote all end in a keep.
  TXT

  # Where the sweep falls back when the remote cannot be reached, in
  # order. A local branch by one of these names is a guess, which is
  # why taking one is always announced.
  FALLBACK_BRANCHES = %w[main master].freeze

  # The branch every verdict is measured against, and where the answer
  # came from -- which the report has to say, because a guess that
  # announces itself can be re-run against the real answer and a silent
  # one cannot. The tip is carried alongside because the remote hands
  # it over in the same breath.
  DefaultBranch = Struct.new(:name, :sha, :source) do
    def from_remote?
      source == :remote
    end
  end

  # The parsed command line. Held as a value rather than a hash so a
  # stage reaching for a flag that does not exist fails where it is
  # written rather than reading as nil.
  Options = Struct.new(:dir, :remote, :delete, :help) do
    def delete?
      delete
    end

    def help?
      help
    end
  end

  # An option value must not begin with a dash: a mandatory-argument
  # option otherwise swallows a following flag as its value, so
  # `-C --delete` parses as a directory named --delete with no delete
  # flag set, and the sweep acts on the command it misread. Anchored
  # end to end to state explicitly the whole-argument match optparse
  # requires of an acceptance pattern.
  VALUE_NOT_FLAG = /\A[^-].*\z/m

  module_function

  # Parsed here rather than in the CLI class below because nothing about
  # it reaches outside the process: this is the last point at which what
  # the caller typed can still be refused for free.
  def parse_options(argv)
    values = {}
    flags = { delete: false, help: false }
    rest = permute(argv, values, flags)
    raise Error, "unexpected extra arguments: #{rest.map(&:inspect).join(', ')}" unless rest.empty?

    Options.new(values.fetch(:dir, '.'), values.fetch(:remote, DEFAULT_REMOTE),
                flags[:delete], flags[:help])
  end

  def permute(argv, values, flags)
    parser = OptionParser.new do |o|
      o.banner = USAGE
      o.on('-C DIR', VALUE_NOT_FLAG) { |v| set_once(values, :dir, '-C', v) }
      o.on('--remote NAME', VALUE_NOT_FLAG) { |v| set_once(values, :remote, '--remote', v) }
      # Repeated booleans are accepted where a repeated value option is
      # refused: repeating one discards no input and leaves the sweep
      # acting on exactly what was typed.
      o.on('--delete') { flags[:delete] = true }
      o.on('-h', '--help') { flags[:help] = true }
    end
    # permute, not parse: #parse permutes positionals past flags only
    # while POSIXLY_CORRECT is unset, so the same argv would mean two
    # things on two machines.
    parser.permute(argv)
  rescue OptionParser::ParseError => e
    raise Error, e.message
  end

  # Last-wins on a repeated option silently discards the first value,
  # which for -C means sweeping a repository the caller also named and
  # did not get.
  def set_once(values, key, flag, value)
    raise Error, "duplicate #{flag}" if values.key?(key)

    values[key] = value
  end

  # `ls-remote --symref <remote> HEAD` answers in two lines: the symref
  # naming the branch, then that branch's tip.
  #
  #   ref: refs/heads/develop<TAB>HEAD
  #   55a8fc0a4f21946df49bb9900352cd09e2ef2fc2<TAB>HEAD
  #
  # An empty remote prints the first line and not the second, so the
  # name is the answer and the tip is what may be missing.
  def parse_remote_head(output)
    name = output[%r{^ref: refs/heads/(\S+)\tHEAD$}, 1]
    return nil unless name

    DefaultBranch.new(name, output[/^([0-9a-f]{4,64})\tHEAD$/, 1], :remote)
  end

  # The only code here that shells out, and the only code that knows
  # the repository is somewhere other than where this process is
  # standing.
  class Git
    attr_reader :remote

    def initialize(dir:, remote:)
      @dir = dir
      @remote = remote
    end

    def capture(*args)
      Open3.capture3('git', '-C', @dir, *args)
    rescue Errno::ENOENT
      raise Error, 'git not found on PATH'
    end

    # For the several facts git answers by succeeding or failing rather
    # than by printing.
    def succeeds?(*args)
      capture(*args).last.success?
    end

    def lines(*args)
      stdout, stderr, status = capture(*args)
      raise Error, "git #{args.first} failed: #{stderr.strip}" unless status.success?

      stdout.lines(chomp: true)
    end

    def remotes
      lines('remote')
    end

    # --verify with a full refname, so a tag of the same name cannot
    # answer for a branch that does not exist.
    def ref?(name)
      succeeds?('show-ref', '--verify', '--quiet', name)
    end

    def local_branch?(name)
      ref?("refs/heads/#{name}")
    end

    def sha(ref)
      lines('rev-parse', ref).first
    end

    # nil rather than a failure where the ref is absent or is not
    # symbolic, both of which are ordinary states rather than problems.
    def symbolic_ref(name)
      stdout, _stderr, status = capture('symbolic-ref', '--quiet', name)
      status.success? ? stdout.strip : nil
    end

    # What the verdicts are measured against, once the default branch
    # has a name. The remote-tracking ref is the remote's own state as
    # of the last fetch; the local branch of the same name is whatever
    # this developer happens to have advanced, and measuring against
    # unpushed commits on it would clear branches whose work reached
    # nobody. Where nothing tracks the remote -- a single-branch clone,
    # pruned refs -- the local branch is all there is.
    def default_ref(name)
      tracking = "refs/remotes/#{remote}/#{name}"
      return tracking if ref?(tracking)

      local = "refs/heads/#{name}"
      return local if ref?(local)

      raise Error, "nothing to measure against: neither #{tracking} nor #{local} exists"
    end

    def default_branch
      assert_remote_configured!
      stdout, _stderr, status = capture('ls-remote', '--symref', remote, 'HEAD')
      head = status.success? ? StaleBranches.parse_remote_head(stdout) : nil

      head || fallback_default_branch
    end

    private

    # A remote that was never configured is a misspelling, and the
    # fallback below is not the answer to one: continuing would measure
    # every verdict against a branch nobody named. A remote that exists
    # and cannot be reached is the different case the fallback is for.
    def assert_remote_configured!
      configured = remotes
      return if configured.include?(remote)

      known = configured.empty? ? 'this repository has none' : "configured: #{configured.join(', ')}"
      raise Error, "no such remote: #{remote} (#{known})"
    end

    def fallback_default_branch
      name = FALLBACK_BRANCHES.find { |candidate| local_branch?(candidate) }
      unless name
        raise Error, "could not ask #{remote} for its default branch, and no local " \
                     "#{FALLBACK_BRANCHES.join(' or ')} to fall back to"
      end

      DefaultBranch.new(name, nil, :fallback)
    end
  end

  # Gathers the facts and reaches the verdicts. The CLI hands it a way
  # to talk to git; it hands back rows to print and warnings to say
  # first.
  class Sweep
    attr_reader :default, :measured_ref, :warnings

    def initialize(git)
      @git = git
      @warnings = []
    end

    def run
      @default = @git.default_branch
      @warnings << fallback_warning unless @default.from_remote?
      @measured_ref = @git.default_ref(@default.name)
      note_stale_tracking_ref
      note_stale_head_ref
      self
    end

    private

    def fallback_warning
      "could not ask #{@git.remote} for its default branch; " \
        "measuring against #{@default.name} instead"
    end

    # Behind the remote because nobody has fetched. This does not make
    # the verdicts wrong so much as older: an earlier tip clears fewer
    # branches, so the sweep keeps more than it needs to. What the
    # caller cannot tell without being told is that a keep reading
    # "this work never landed" may only mean "this work landed after
    # your last fetch".
    def note_stale_tracking_ref
      return unless @default.sha
      return if @git.sha(@measured_ref) == @default.sha

      @warnings << "#{@measured_ref} is behind #{@git.remote}; run " \
                   "`git fetch #{@git.remote}` -- until then a keep may mean nothing more " \
                   'than that the work landed after your last fetch'
    end

    # This sweep never reads refs/remotes/<remote>/HEAD, which is what
    # makes a stale one harmless here and nowhere else: every
    # `origin/HEAD` shorthand the caller types resolves through it.
    # Having asked the remote already, saying so costs one comparison.
    def note_stale_head_ref
      target = @git.symbolic_ref("refs/remotes/#{@git.remote}/HEAD")
      return unless target

      named = target.sub(%r{\Arefs/remotes/#{Regexp.escape(@git.remote)}/}, '')
      return if named == @default.name

      @warnings << "refs/remotes/#{@git.remote}/HEAD still names #{named}, but " \
                   "#{@git.remote} says #{@default.name}; run " \
                   "`git remote set-head #{@git.remote} --auto`. This sweep asked the " \
                   'remote, so its own verdicts are unaffected'
    end
  end

  # The half that talks to the outside world: everything above is a pure
  # function of what it was handed.
  class CLI
    def self.run(argv)
      new.run(argv)
    end

    def run(argv)
      options = StaleBranches.parse_options(argv)
      return puts(StaleBranches::USAGE) if options.help?

      sweep = Sweep.new(Git.new(dir: options.dir, remote: options.remote)).run
      # Warnings come before the report rather than after it: a caller
      # reading a piped report from the top must meet the caveats
      # before the rows they apply to.
      sweep.warnings.each { |warning| warn "stale-branches: #{warning}" }
    rescue Error => e
      abort "stale-branches: #{e.message}"
    end
  end
end

StaleBranches::CLI.run(ARGV) if $PROGRAM_NAME == __FILE__
