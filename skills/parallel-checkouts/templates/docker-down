#!/usr/bin/env bash
# parallel-checkouts template v1 (bendyworks/claude-skills)
#
# Stop this checkout's stack and remove its containers. Safe from any
# directory, for the reasons bin/docker-up gives. Extra arguments go to
# `docker compose down`; `--volumes` also deletes this checkout's databases.
# See docs/parallel-checkouts.md.
set -eu

root="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
. "$root/bin/compose-project" || exit 1

compose down "$@"
