#!/usr/bin/env bash
# parallel-checkouts template v1 (bendyworks/claude-skills)
#
# Sourced, not executed: verifies that this shell's parallel-checkout
# identity agrees with this checkout's, and defines the `compose` wrapper
# every stack script runs through. See docs/parallel-checkouts.md.
#
# Compose resolves the project name and interpolates the compose file from
# the env file beside it, with a documented per-variable precedence: the
# `-p` flag, then the environment, then that env file. What Compose cannot
# do is notice that the shell is lying about which checkout it is in. An
# exported variable outranks the file, so a shell carrying another
# checkout's COMPOSE_PROJECT_NAME resolves that checkout's containers,
# silently and with a zero exit status. The ports are the same hazard in a
# subtler form: a shell carrying one checkout's port block with a matching
# project name composes a hybrid, and a routine `up` recreates containers
# on the wrong ports.
#
# So this file compares the checkout's identity with the environment and
# refuses on any disagreement, rather than guessing which checkout was
# meant. The identity is COMPOSE_PROJECT_NAME, PRJ_CHECKOUT_SUFFIX,
# PRJ_CHECKOUT_INDEX, PRJ_CHECKOUT_ROOT, PRJ_PORT_OFFSET, and PRJ_*_PORT:
# names the skill generates and values that are safe to print. Other PRJ_*
# variables are the project's own, possibly secrets, and are never read.
# An exported identity variable the file does not set is refused too,
# since Compose would use it. The one thing this file decides is
# COMPOSE_PROJECT_NAME: having verified it, it exports it, so child
# processes and an override file's `name:` cannot redirect a command. The
# .envrc block in docs/parallel-checkouts.md writes exactly these names
# into the env file; the two lists must match.
#
# A checkout with no identity at all -- none in the env file, none in the
# shell -- is a teammate's original checkout that never set one up, and
# runs with the compose file's own default name. A checkout the skill
# added carries a parallel-checkout marker in its git directory, and is
# refused instead: without its identity it would reach the original
# checkout's stack.
#
# It reads the file the way Compose's dotenv parser does for the shapes a
# generated identity file holds: an optional `export` prefix, CRLF endings,
# whitespace around the `=`, one layer of quotes, and a trailing comment
# after a quoted value or after a space in an unquoted one. Backslash
# escapes, `${VAR}` interpolation, multi-line quoted values, and the
# `KEY: value` form are not implemented, and each fails closed, as a
# refusal rather than a wrong answer. Nothing the file says is evaluated:
# a key must be a shell variable name, and values are stored with
# `printf -v`. A bare `KEY` line, which Compose fills from the environment,
# is refused for an identity variable.
#
# Callers source it as `. bin/compose-project || exit 1`, which suppresses
# `set -e` inside it, so every failure path here is an explicit
# `return 1`. It targets bash 3.2, macOS's /bin/bash.

if [ -z "${BASH_SOURCE[0]:-}" ]; then
  echo "${0##*/}: needs bash (BASH_SOURCE is empty under zsh, so the checkout root would resolve wrongly); run the bin/ scripts rather than sourcing this by hand" >&2
  return 1 2>/dev/null || exit 1
fi

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  echo "${0##*/}: source this file, do not execute it; the bin/ scripts do that for you" >&2
  exit 64
fi

compose_project_root="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# The one path a project adapts when it copies this template: the directory
# holding the compose file, its env file, and any personal override file.
compose_project_dir="$compose_project_root/.devcontainer"
compose_project_env_file="$compose_project_dir/.env"
compose_project_files=(-f "$compose_project_dir/docker-compose.yml")

compose_project_is_identity() {
  case "$1" in
    COMPOSE_PROJECT_NAME|PRJ_CHECKOUT_SUFFIX|PRJ_CHECKOUT_INDEX|PRJ_CHECKOUT_ROOT|PRJ_PORT_OFFSET|PRJ_*_PORT) return 0 ;;
  esac
  return 1
}

# Spelled out rather than [A-Za-z], which bash 3.2 matches by locale.
compose_project_is_name() {
  case "$1" in
    ''|[0123456789]*|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_]*) return 1 ;;
  esac
  return 0
}

# Normalize one raw value as Compose's dotenv parser would. A quoted value
# ends at its closing quote, whatever follows it; an unquoted value loses a
# trailing comment only where a space precedes the '#'.
compose_project_clean_value() {
  local raw="$1" quote rest

  raw="${raw#"${raw%%[![:space:]]*}"}"
  raw="${raw%"${raw##*[![:space:]]}"}"

  case "$raw" in
    '"'*|"'"*)
      quote="${raw:0:1}"
      rest="${raw:1}"
      case "$rest" in
        *"$quote"*) raw="${rest%%"$quote"*}" ;;
      esac
      ;;
    *" #"*)
      raw="${raw%%" #"*}"
      raw="${raw%"${raw##*[![:space:]]}"}"
      ;;
  esac

  printf '%s' "$raw"
}

# Strip a line down to what Compose would see: KEY=VALUE with the key
# trimmed, the line unchanged when it holds no `=`, or nothing for a blank
# line or a comment.
compose_project_strip_line() {
  local line="$1" key

  line="${line%$'\r'}"
  line="${line#"${line%%[![:space:]]*}"}"
  case "$line" in
    export[[:space:]]*)
      line="${line#export}"
      line="${line#"${line%%[![:space:]]*}"}"
      ;;
  esac

  case "$line" in
    ''|'#'*) return 0 ;;
    *=*)
      key="${line%%=*}"
      key="${key%"${key##*[![:space:]]}"}"
      line="$key=${line#*=}"
      ;;
  esac

  printf '%s' "$line"
}

compose_project_has_key() {
  local key
  for key in ${compose_project_keys[@]+"${compose_project_keys[@]}"}; do
    [ "$key" = "$1" ] && return 0
  done
  return 1
}

case "$(declare -p COMPOSE_ENV_FILES 2>/dev/null)" in
  "declare -x"*) compose_project_env_override=1 ;;
  *) compose_project_env_override="" ;;
esac
if [ -n "$compose_project_env_override" ]; then
  echo "${0##*/}: COMPOSE_ENV_FILES is set in this shell, so Compose would read another env file than the $compose_project_env_file this checks; unset it -- see docs/parallel-checkouts.md" >&2
  return 1
fi

# Collect the file's identity; the last assignment of a variable wins, as
# in Compose.
compose_project_keys=()
while IFS= read -r compose_project_line || [ -n "$compose_project_line" ]; do
  compose_project_line="$(compose_project_strip_line "$compose_project_line")"
  # Compose ends a key at the first `=` or `:`, whichever comes first.
  compose_project_key="${compose_project_line%%[=:]*}"
  compose_project_sep="${compose_project_line:${#compose_project_key}:1}"
  compose_project_key="${compose_project_key%"${compose_project_key##*[![:space:]]}"}"
  compose_project_is_identity "$compose_project_key" || continue
  case "$compose_project_sep" in
    ':')
      echo "${0##*/}: $compose_project_env_file sets $compose_project_key in the KEY: value form, which this check does not read; write it as KEY=value -- regenerate the file with a direnv load, per docs/parallel-checkouts.md" >&2
      return 1
      ;;
    '')
      echo "${0##*/}: $compose_project_env_file names $compose_project_key with no value, which Compose takes from the environment; write it as KEY=value -- regenerate the file with a direnv load, per docs/parallel-checkouts.md" >&2
      return 1
      ;;
  esac

  if ! compose_project_is_name "$compose_project_key"; then
    echo "${0##*/}: $compose_project_env_file has an identity line whose name is not a shell variable name; refusing to interpret it -- regenerate the file with a direnv load, per docs/parallel-checkouts.md" >&2
    return 1
  fi

  printf -v "compose_project_value_$compose_project_key" '%s' "$(compose_project_clean_value "${compose_project_line#*=}")"
  compose_project_has_key "$compose_project_key" || compose_project_keys+=("$compose_project_key")
done < <(cat -- "$compose_project_env_file" 2>/dev/null)

# Compare with what the shell exports; an unexported shell variable never
# reaches Compose. Set-but-empty counts as disagreement: Compose asks
# whether a variable is set, not whether it has a value.
compose_project_name=""
while IFS= read -r compose_project_key; do
  compose_project_is_identity "$compose_project_key" || continue
  compose_project_have="${!compose_project_key}"
  compose_project_shown="$compose_project_have"
  [ -z "$compose_project_shown" ] && compose_project_shown="(set, but empty)"

  if ! compose_project_has_key "$compose_project_key"; then
    echo "${0##*/}: this shell carries $compose_project_key=$compose_project_shown, but $compose_project_env_file does not set it, so this command would act on a different checkout's stack; unset $compose_project_key or run it from this checkout's own direnv shell -- see docs/parallel-checkouts.md" >&2
    return 1
  fi

  compose_project_want_var="compose_project_value_$compose_project_key"
  compose_project_want="${!compose_project_want_var}"
  if [ "$compose_project_have" != "$compose_project_want" ]; then
    echo "${0##*/}: $compose_project_key=$compose_project_shown (this shell) disagrees with $compose_project_env_file ($compose_project_want), so this command would act on a different checkout's stack than the one it lives in; run it from this checkout's own direnv shell, or unset $compose_project_key -- see docs/parallel-checkouts.md" >&2
    return 1
  fi
done <<COMPOSE_PROJECT_EXPORTED
$(compgen -e)
COMPOSE_PROJECT_EXPORTED

compose_project_has_key COMPOSE_PROJECT_NAME && compose_project_name="$compose_project_value_COMPOSE_PROJECT_NAME"
compose_project_marker="$(git -C "$compose_project_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)/parallel-checkout"
if [ -n "$compose_project_name" ]; then
  export COMPOSE_PROJECT_NAME="$compose_project_name"
elif [ ${#compose_project_keys[@]} -gt 0 ]; then
  echo "${0##*/}: $compose_project_env_file sets part of an identity but names no COMPOSE_PROJECT_NAME; regenerate it with a direnv load, per docs/parallel-checkouts.md" >&2
  return 1
elif [ -f "$compose_project_marker" ]; then
  echo "${0##*/}: this is parallel checkout $(cat -- "$compose_project_marker") but has no identity in this shell or in $compose_project_env_file, so it would reach the original checkout's stack; load its .envrc (direnv allow) -- see docs/parallel-checkouts.md" >&2
  return 1
fi

# An explicit -f disables Compose's own loading of an override file, so a
# personal docker-compose.override.yml beside the compose file is named
# here, and announced: it is untracked and can change what every container
# is.
if [ -f "$compose_project_dir/docker-compose.override.yml" ]; then
  compose_project_files+=(-f "$compose_project_dir/docker-compose.override.yml")
  # A caller re-checking after its own first check sets compose_project_quiet,
  # so the notice appears once per command.
  [ -n "${compose_project_quiet:-}" ] ||
    echo "${0##*/}: including ${compose_project_dir#"$compose_project_root"/}/docker-compose.override.yml" >&2
fi

# compose_project_files and compose_project_env_file stay set for the
# scripts that source this one; everything else it used is cleared below.
compose() {
  docker compose "${compose_project_files[@]}" "$@"
}

for compose_project_key in ${compose_project_keys[@]+"${compose_project_keys[@]}"}; do
  unset "compose_project_value_$compose_project_key"
done
unset compose_project_root compose_project_dir compose_project_keys compose_project_quiet \
  compose_project_sep compose_project_env_override compose_project_marker \
  compose_project_line compose_project_key compose_project_name compose_project_have \
  compose_project_shown compose_project_want compose_project_want_var
unset -f compose_project_is_identity compose_project_is_name compose_project_clean_value \
  compose_project_strip_line compose_project_has_key
